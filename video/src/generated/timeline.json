  "chapters": [
    {
      "id": "hook",
      "tag": "PROLOGUE",
      "index": "00",
      "title": "隔桌有眼",
      "subtitle": "同一杯咖啡，同一句话，另一双眼睛",
      "mood": "mystery",
      "start": 0.0,
      "end": 16.4967,
      "duration": 16.4967,
      "leadIn": 0.5,
      "tail": 0.8,
      "beats": [
        {
          "id": "h1",
          "text": "这句话，你没发给第二个人。",
          "speak": null,
          "voice": "narrator",
          "start": 0.6,
          "audioStart": 0.6,
          "audioDuration": 1.8529,
          "end": 2.4529,
          "duration": 1.8529,
          "hold": false
        },
        {
          "id": "h2",
          "text": "但隔壁桌的人，已经看到了。",
          "speak": null,
          "voice": "narrator",
          "start": 2.9029,
          "audioStart": 2.9029,
          "audioDuration": 1.8804,
          "end": 4.7833,
          "duration": 1.8804,
          "hold": false
        },
        {
          "id": "h3",
          "text": "同一个无线网络下，不用碰你的电脑，也不用你点任何东西。",
          "speak": null,
          "voice": "narrator",
          "start": 5.3833,
          "audioStart": 5.3833,
          "audioDuration": 3.6618,
          "end": 9.0451,
          "duration": 3.6618,
          "hold": false
        },
        {
          "id": "h4",
          "text": "2026 年 10 月，一把用了十年的网络锁，被人发现——钥匙一直插在锁上。",
          "speak": null,
          "voice": "narrator",
          "start": 9.6451,
          "audioStart": 9.6451,
          "audioDuration": 5.4516,
          "end": 15.0967,
          "duration": 5.4516,
          "hold": false
        }
      ]
    },
    {
      "id": "cert",
      "tag": "0x01",
      "index": "01",
      "title": "小锁、身份证、章",
      "subtitle": "浏览器认的不是你，是章",
      "mood": "curiosity",
      "start": 16.4967,
      "end": 49.8183,
      "duration": 33.3216,
      "leadIn": 0.5,
      "tail": 0.8,
      "beats": [
        {
          "id": "c1",
          "text": "你每天在浏览器看到的那把小锁，其实是浏览器在说：我验过它的身份证。",
          "speak": null,
          "voice": "narrator",
          "start": 17.0967,
          "audioStart": 17.0967,
          "audioDuration": 4.5054,
          "end": 21.6021,
          "duration": 4.5054,
          "hold": false
        },
        {
          "id": "c2",
          "text": "身份证，就是证书。发证的，叫 CA。",
          "speak": null,
          "voice": "narrator",
          "start": 22.0021,
          "audioStart": 22.0021,
          "audioDuration": 3.642,
          "end": 25.6442,
          "duration": 3.642,
          "hold": false
        },
        {
          "id": "c3",
          "text": "CA 盖个章，浏览器就认。",
          "speak": null,
          "voice": "narrator",
          "start": 26.0442,
          "audioStart": 26.0442,
          "audioDuration": 1.9531,
          "end": 27.9973,
          "duration": 1.9531,
          "hold": false
        },
        {
          "id": "c4",
          "text": "如果这个章，被偷了呢？",
          "speak": null,
          "voice": "narrator",
          "start": 28.3973,
          "audioStart": 28.3973,
          "audioDuration": 1.5622,
          "end": 29.9595,
          "duration": 1.5622,
          "hold": false
        },
        {
          "id": "c5",
          "text": "出事的，是印度 CA 机构 eMudhra 的 8 张中间证书。",
          "speak": null,
          "voice": "narrator",
          "start": 30.5095,
          "audioStart": 30.5095,
          "audioDuration": 3.6674,
          "end": 34.1769,
          "duration": 3.6674,
          "hold": false
        },
        {
          "id": "c6",
          "text": "中间证书，相当于 CA 的分包商。",
          "speak": null,
          "voice": "narrator",
          "start": 34.6769,
          "audioStart": 34.6769,
          "audioDuration": 2.4182,
          "end": 37.0951,
          "duration": 2.4182,
          "hold": false
        },
        {
          "id": "c7",
          "text": "这 8 张证书的私钥，本该是一个 384 位的随机数。",
          "speak": null,
          "voice": "narrator",
          "start": 37.4951,
          "audioStart": 37.4951,
          "audioDuration": 3.3357,
          "end": 40.8308,
          "duration": 3.3357,
          "hold": false
        },
        {
          "id": "c8",
          "text": "实际只有 8 位。几毫秒，就能试完。",
          "speak": null,
          "voice": "narrator",
          "start": 41.2808,
          "audioStart": 41.2808,
          "audioDuration": 3.1012,
          "end": 44.382,
          "duration": 3.1012,
          "hold": false
        },
        {
          "id": "c9",
          "text": "这 8 张证书，能签任何域名，包括你的银行网站。",
          "speak": null,
          "voice": "narrator",
          "start": 44.982,
          "audioStart": 44.982,
          "audioDuration": 3.5362,
          "end": 48.5183,
          "duration": 3.5362,
          "hold": false
        }
      ]
    },
    {
      "id": "response",
      "tag": "0x02",
      "index": "02",
      "title": "一百分钟",
      "subtitle": "浏览器封得有多快",
      "mood": "relief",
      "start": 49.8183,
      "end": 69.4993,
      "duration": 19.681,
      "leadIn": 0.45,
      "tail": 0.7,
      "beats": [
        {
          "id": "s1",
          "text": "10 月 17 日，研究者公开了私钥签名。",
          "speak": null,
          "voice": "narrator",
          "start": 50.3683,
          "audioStart": 50.3683,
          "audioDuration": 2.9097,
          "end": 53.278,
          "duration": 2.9097,
          "hold": false
        },
        {
          "id": "s2",
          "text": "Chrome 在 100 分钟内，拉黑了这 8 张证书。",
          "speak": null,
          "voice": "narrator",
          "start": 53.678,
          "audioStart": 53.678,
          "audioDuration": 2.5259,
          "end": 56.2038,
          "duration": 2.5259,
          "hold": false
        },
        {
          "id": "s3",
          "text": "Firefox 在 3 小时后跟进。",
          "speak": null,
          "voice": "narrator",
          "start": 56.7038,
          "audioStart": 56.7038,
          "audioDuration": 1.8225,
          "end": 58.5264,
          "duration": 1.8225,
          "hold": false
        },
        {
          "id": "s4",
          "text": "第二天，eMudhra 正式吊销。",
          "speak": null,
          "voice": "narrator",
          "start": 59.0264,
          "audioStart": 59.0264,
          "audioDuration": 2.1859,
          "end": 61.2123,
          "duration": 2.1859,
          "hold": false
        },
        {
          "id": "s5",
          "text": "这可能是互联网史上最快的一次证书响应。",
          "speak": null,
          "voice": "narrator",
          "start": 61.7123,
          "audioStart": 61.7123,
          "audioDuration": 2.4684,
          "end": 64.1807,
          "duration": 2.4684,
          "hold": false
        },
        {
          "id": "s6",
          "text": "浏览器全绿。安全了？",
          "speak": null,
          "voice": "narrator",
          "start": 64.6807,
          "audioStart": 64.6807,
          "audioDuration": 1.9245,
          "end": 66.6052,
          "duration": 1.9245,
          "hold": false
        },
        {
          "id": "s7",
          "text": "真的吗？",
          "speak": null,
          "voice": "narrator",
          "start": 67.2052,
          "audioStart": 67.2052,
          "audioDuration": 0.3941,
          "end": 67.5993,
          "duration": 0.3941,
          "hold": false
        }
      ]
    },
    {
      "id": "blind",
      "tag": "0x03",
      "index": "03",
      "title": "关不上的窗",
      "subtitle": "吊销是一张通缉令，可有人不看",
      "mood": "tension",
      "start": 69.4993,
      "end": 96.2705,
      "duration": 26.7712,
      "leadIn": 0.5,
      "tail": 0.7,
      "beats": [
        {
          "id": "b1",
          "text": "吊销，只是一张通缉令。有些客户端，根本不看。",
          "speak": null,
          "voice": "narrator",
          "start": 70.0993,
          "audioStart": 70.0993,
          "audioDuration": 3.7333,
          "end": 73.8326,
          "duration": 3.7333,
          "hold": false
        },
        {
          "id": "b2",
          "text": "macOS 自带的 curl、git、python3，只认根证书，不查吊销。",
          "speak": null,
          "voice": "narrator",
          "start": 74.2826,
          "audioStart": 74.2826,
          "audioDuration": 4.7656,
          "end": 79.0482,
          "duration": 4.7656,
          "hold": false
        },
        {
          "id": "b3",
          "text": "各种开发工具、运行时、桌面客户端，各带一份信任库。系统更新，它们不会变。",
          "speak": null,
          "voice": "narrator",
          "start": 79.4982,
          "audioStart": 79.4982,
          "audioDuration": 6.4547,
          "end": 85.9529,
          "duration": 6.4547,
          "hold": false
        },
        {
          "id": "b4",
          "text": "飞书、办公软件、各种智能助手，也在等更新。",
          "speak": null,
          "voice": "narrator",
          "start": 86.4529,
          "audioStart": 86.4529,
          "audioDuration": 3.6059,
          "end": 90.0588,
          "duration": 3.6059,
          "hold": false
        },
        {
          "id": "b5",
          "text": "前门锁了，窗户还开着。",
          "speak": null,
          "voice": "narrator",
          "start": 90.5088,
          "audioStart": 90.5088,
          "audioDuration": 1.6682,
          "end": 92.177,
          "duration": 1.6682,
          "hold": false
        },
        {
          "id": "b6",
          "text": "一扇窗没关，整栋房子都漏风。",
          "speak": null,
          "voice": "narrator",
          "start": 92.677,
          "audioStart": 92.677,
          "audioDuration": 2.4436,
          "end": 95.1205,
          "duration": 2.4436,
          "hold": false
        }
      ]
    },
    {
      "id": "demo",
      "tag": "0x04",
      "index": "04",
      "title": "透明局域网",
      "subtitle": "只要一台手机，连上同一个热点",
      "mood": "demo",
      "start": 96.2705,
      "end": 120.2875,
      "duration": 24.017,
      "leadIn": 0.5,
      "tail": 0.7,
      "beats": [
        {
          "id": "d1",
          "text": "为了证明，我做了个工具：Distrust。",
          "speak": null,
          "voice": "narrator",
          "start": 96.8705,
          "audioStart": 96.8705,
          "audioDuration": 2.2039,
          "end": 99.0745,
          "duration": 2.2039,
          "hold": false
        },
        {
          "id": "d2",
          "text": "一台电脑，一部手机，连同一个热点。",
          "speak": null,
          "voice": "narrator",
          "start": 99.4745,
          "audioStart": 99.4745,
          "audioDuration": 2.484,
          "end": 101.9585,
          "duration": 2.484,
          "hold": false
        },
        {
          "id": "d3",
          "text": "手机冒充网关，流量拐进手机。",
          "speak": null,
          "voice": "narrator",
          "start": 102.3585,
          "audioStart": 102.3585,
          "audioDuration": 2.3776,
          "end": 104.7361,
          "duration": 2.3776,
          "hold": false
        },
        {
          "id": "d7",
          "text": "聊天记录，一条一条出现在另一块屏幕上。",
          "speak": null,
          "voice": "narrator",
          "start": 105.2361,
          "audioStart": 105.2361,
          "audioDuration": 2.6778,
          "end": 107.9139,
          "duration": 2.6778,
          "hold": false
        },
        {
          "id": "d8",
          "text": "还能篡改。替你给老板发一句——",
          "speak": null,
          "voice": "narrator",
          "start": 108.3139,
          "audioStart": 108.3139,
          "audioDuration": 2.3136,
          "end": 110.6275,
          "duration": 2.3136,
          "hold": false
        },
        {
          "id": "d8b",
          "text": "老子不干了。",
          "speak": null,
          "voice": "attacker",
          "start": 111.1275,
          "audioStart": 111.1275,
          "audioDuration": 0.9173,
          "end": 112.0447,
          "duration": 0.9173,
          "hold": false
        },
        {
          "id": "d9",
          "text": "而你的屏幕，一切正常。",
          "speak": null,
          "voice": "narrator",
          "start": 113.0447,
          "audioStart": 113.0447,
          "audioDuration": 1.7861,
          "end": 114.8308,
          "duration": 1.7861,
          "hold": false
        },
        {
          "id": "d10",
          "text": "这还只是其中一个应用。同一个口子，还能干别的。",
          "speak": null,
          "voice": "narrator",
          "start": 115.4308,
          "audioStart": 115.4308,
          "audioDuration": 3.5567,
          "end": 118.9875,
          "duration": 3.5567,
          "hold": false
        }
      ]
    },
    {
      "id": "risk",
      "tag": "0x05",
      "index": "05",
      "title": "不止聊天",
      "subtitle": "同一个口子，能干的事还有很多",
      "mood": "danger",
      "start": 120.2875,
      "end": 137.3931,
      "duration": 17.1056,
      "leadIn": 0.5,
      "tail": 0.6,
      "beats": [
        {
          "id": "x2",
          "text": "你让智能助手写代码，它可能替你执行一条删库命令。",
          "speak": null,
          "voice": "narrator",
          "start": 120.8875,
          "audioStart": 120.8875,
          "audioDuration": 3.6788,
          "end": 124.5663,
          "duration": 3.6788,
          "hold": false
        },
        {
          "id": "x3",
          "text": "你连的免费节点，可能正在偷看你的密码。",
          "speak": null,
          "voice": "narrator",
          "start": 125.0663,
          "audioStart": 125.0663,
          "audioDuration": 2.6355,
          "end": 127.7018,
          "duration": 2.6355,
          "hold": false
        },
        {
          "id": "x4",
          "text": "你的银行凭证，可能正躺在别人屏幕上。",
          "speak": null,
          "voice": "narrator",
          "start": 128.2018,
          "audioStart": 128.2018,
          "audioDuration": 2.4279,
          "end": 130.6297,
          "duration": 2.4279,
          "hold": false
        },
        {
          "id": "x5",
          "text": "一个没更新的客户端，就够了。",
          "speak": null,
          "voice": "narrator",
          "start": 131.1297,
          "audioStart": 131.1297,
          "audioDuration": 1.9432,
          "end": 133.0729,
          "duration": 1.9432,
          "hold": false
        },
        {
          "id": "x6",
          "text": "你以为的安全，只是因为还没人对你出手。",
          "speak": null,
          "voice": "narrator",
          "start": 133.5729,
          "audioStart": 133.5729,
          "audioDuration": 2.7202,
          "end": 136.2931,
          "duration": 2.7202,
          "hold": false
        }
      ]
    },
    {
      "id": "fix",
      "tag": "0x06",
      "index": "06",
      "title": "现在，去更新",
      "subtitle": "保持更新，别连陌生热点",
      "mood": "resolve",
      "start": 137.3931,
      "end": 156.8033,
      "duration": 19.4102,
      "leadIn": 0.5,
      "tail": 1.2,
      "beats": [
        {
          "id": "f1",
          "text": "记住两件事。",
          "speak": null,
          "voice": "narrator",
          "start": 137.9931,
          "audioStart": 137.9931,
          "audioDuration": 0.8232,
          "end": 138.8163,
          "duration": 0.8232,
          "hold": false
        },
        {
          "id": "f2",
          "text": "第一，保持更新。系统、浏览器、旧软件，一个都别漏。",
          "speak": null,
          "voice": "narrator",
          "start": 139.2163,
          "audioStart": 139.2163,
          "audioDuration": 4.5635,
          "end": 143.7798,
          "duration": 4.5635,
          "hold": false
        },
        {
          "id": "f3",
          "text": "第二，别连陌生热点，尤其别登录账号。",
          "speak": null,
          "voice": "narrator",
          "start": 144.2798,
          "audioStart": 144.2798,
          "audioDuration": 3.0484,
          "end": 147.3282,
          "duration": 3.0484,
          "hold": false
        },
        {
          "id": "f4",
          "text": "现在，去更新。",
          "speak": null,
          "voice": "narrator",
          "start": 147.9282,
          "audioStart": 147.9282,
          "audioDuration": 1.2151,
          "end": 149.1433,
          "duration": 1.2151,
          "hold": false
        },
        {
          "id": "f_end",
          "text": "",
          "start": 149.9433,
          "audioStart": null,
          "audioDuration": 0,
          "end": 155.4433,
          "duration": 5.5,
          "hold": true
        }
      ]
    }
